# Curio.OS Backend — Environment Variables
# Copy to .env.local or configure in your hosting dashboard

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:...@ep-...pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-here-at-least-32-chars

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev:
CORS_ORIGINS=http://localhost:5173
# Prod (add your Vercel/Netlify URL):
# CORS_ORIGINS=http://localhost:5173,https://curio-os.vercel.app
