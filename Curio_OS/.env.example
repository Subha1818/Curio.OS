# Curio.OS Frontend — Environment Variables
# Copy this file to .env.local (for local dev) or configure in your hosting dashboard

# ── Backend API URL ─────────────────────────────────────────────────────────────
# Development: points to your local Express server
VITE_API_URL=http://localhost:4000

# Production (Render / Railway / Fly.io): set this to your deployed backend URL
# VITE_API_URL=https://curio-server.onrender.com
