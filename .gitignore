# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment variables & secrets (CRITICAL: Do NOT commit)
.env
**/.env
.env.*
**/.env.*
.env.local
**/.env.local
!.env.example
!**/.env.example

# Incoming media drops for developer CLI (raw drops not committed)
curio-server/incoming/*
!curio-server/incoming/.gitignore

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
